{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "framework": null,
  "headers": [
    {"source": "/static/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]},
    {"source": "/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex"}]}
  ]
}
